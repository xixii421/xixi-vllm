# Teaching mini-vLLM series repo (vllm-v0 … vllm-v7)
#
# Strategy: ignore everything at the monorepo root, then explicitly
# allow only the teaching version trees. Nested repos such as
# dzyy_vllm/, ullm/, vllm/, nano-vllm/ stay untracked.

# --- default: ignore all root entries ---
/*

# --- keep git meta / series docs ---
!.gitignore
!README.md
!.python-version
!pyproject.toml
!uv.lock
!项目介绍.md
!BENCHMARK_RTX4060_LAPTOP.md
!/utils/
!/utils/**
# only the helper under scripts/git/ (not other local scripts/)
!/scripts/
/scripts/*
!/scripts/git/
!/scripts/git/**

# --- teaching versions only ---
!/vllm-v0/
!/vllm-v1/
!/vllm-v2/
!/vllm-v3/
!/vllm-v4/
!/vllm-v5/
!/vllm-v6/
!/vllm-v7/

# --- never commit envs / caches / artifacts (any depth) ---
# cover both real dirs and symlinks (e.g. vllm-v6/.venv -> v5)
**/.venv
**/.venv/
**/venv
**/venv/
**/.python-version
!/.python-version
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/*.egg-info/
**/dist/
**/build/
**/.DS_Store
**/Thumbs.db
**/*.swp
**/*.swo
**/.idea/
**/.vscode/
!**/.vscode/extensions.json

# Never commit profiler traces (can be 50MB–200MB each)
# NOTE: patterns below only affect NEW (untracked) files. Already-tracked
# traces must first be removed with `git rm --cached` (see git log commit msg).
**/traces/
**/trace.json
**/*.pt.trace.json
**/*.nsys-rep
**/chrome_trace*.json

# profiler 产出物（json trace / txt 汇总均可由脚本再生成，一律不入库）
profiler/**/out/
profiler/**/*.nsys-rep
profiler/**/*.sqlite

# Bench outputs / logs / local dumps
**/bench/results/
**/bench/**/results/
**/bench/out/
**/bench/**/out/
**/*.log
**/tmp/
**/.cache/
**/wandb/
**/outputs/
**/checkpoints/

# Local model / HF caches if ever placed under a version tree
**/huggingface/
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
**/*.onnx
**/*.gguf
