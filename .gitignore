# v4 engine, shared utilities, documentation and assets only.
/*
!.gitignore
!README.md
!.python-version
!pyproject.toml
!uv.lock
!/assets/
!/src/
!/run.py
!/run_torchrun.py
!/config.yaml
!/test/
!/bench/
!/docs/

# --- never commit envs / caches / artifacts (any depth) ---
# cover both real directories and symlinks
**/.venv
**/.venv/
**/venv
**/venv/
**/.python-version
!/.python-version
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/*.egg-info/
**/dist/
**/build/
**/.DS_Store
**/Thumbs.db
**/*.swp
**/*.swo
**/.idea/
**/.vscode/
!**/.vscode/extensions.json

# Never commit profiler traces (can be 50MB–200MB each)
# NOTE: patterns below only affect NEW (untracked) files. Already-tracked
# traces must first be removed with `git rm --cached` (see git log commit msg).
**/traces/
**/trace.json
**/*.pt.trace.json
**/*.nsys-rep
**/chrome_trace*.json

# Bench outputs / logs / local dumps
**/bench/results/
**/bench/**/results/
**/bench/out/
**/bench/**/out/
**/*.log
**/tmp/
**/.cache/
**/wandb/
**/outputs/
**/checkpoints/

# Local model / HF caches if ever placed under a version tree
**/huggingface/
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
**/*.onnx
**/*.gguf
