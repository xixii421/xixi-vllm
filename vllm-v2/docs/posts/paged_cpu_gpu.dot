digraph cpu_gpu {
  rankdir=TB;
  bgcolor="white";
  labelloc="t";
  fontname="Droid Sans Fallback";
  fontsize=20;
  label="PagedAttention 的 CPU 与 GPU 分工";
  node [shape=box, style="filled,rounded", fontname="Droid Sans Fallback", fontsize=12, penwidth=1.6, margin="0.22,0.12"];
  edge [color="#475569", penwidth=1.8, arrowsize=0.9];

  // ---------------- CPU 控制面 ----------------
  subgraph cluster_cpu {
    label="CPU  控制面（只处理整数：页号 / 槽位，从不碰显存里的浮点）";
    fontsize=14;
    fontcolor="#1e40af";
    color="#2563eb";
    style="rounded";
    bgcolor="#eff6ff";

    BM  [label="BlockManager\n从空闲页队列 popleft 出页号", fillcolor="#dbeafe", color="#2563eb"];
    BT  [label="block_table = [7, 2]\n逻辑页 → 物理页 的映射", fillcolor="#dbeafe", color="#2563eb"];
    SL  [label="slots_for_range / slot_of\nslot_mapping = [28,29,30,31,8,9]", fillcolor="#dbeafe", color="#2563eb"];

    BM -> BT -> SL;
  }

  // ---------------- 边界 ----------------
  TT [label="_slot_tensor\ntorch.tensor(slots, device=cuda)\n把小整数列表搬上 GPU", fillcolor="#ede9fe", color="#7c3aed", shape=box, style="filled"];

  SL -> TT [label="  一串整数下标", fontsize=11, fontcolor="#7c3aed"];

  // ---------------- GPU 数据面 ----------------
  subgraph cluster_gpu {
    label="GPU  数据面（存放 KV 字节，执行注意力计算）";
    fontsize=14;
    fontcolor="#b45309";
    color="#d97706";
    style="rounded";
    bgcolor="#fffbeb";

    WR   [label="write：index_copy_\n按 slot_mapping 把 K/V 散射进池子", fillcolor="#fef3c7", color="#d97706"];
    POOL [label="PagedKVCache 显存池\ntorch.zeros(device=cuda) 一次性全量分配", fillcolor="#fde68a", color="#b45309"];
    GA   [label="gather\n按 block_table 收集出连续前缀", fillcolor="#fef3c7", color="#d97706"];
    SDPA [label="SDPA 注意力 + 模型前向", fillcolor="#dcfce7", color="#16a34a"];

    WR -> POOL [label="  写入", fontsize=11, fontcolor="#b45309"];
    POOL -> GA [label="  读取", fontsize=11, fontcolor="#b45309"];
    GA -> SDPA;
  }

  TT -> WR [label="  只传下标，不搬数据", fontsize=11, fontcolor="#7c3aed"];
}
