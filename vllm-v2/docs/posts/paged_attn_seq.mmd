%%{init: {'theme': 'base', 'themeVariables': { 'fontSize': '14px' }}}%%
sequenceDiagram
    autonumber
    participant Eng as Engine
    participant BM as BlockManager
    participant Ctx as ForwardContext
    participant Att as Attention
    participant Pool as PagedKVCache

    Note over Eng,Pool: Prefill
    Eng->>BM: allocate(prompt_len)
    BM-->>Eng: block_table
    Eng->>Eng: slots_for_range(0, prompt_len)
    Eng->>Ctx: set(is_prefill, slot_mapping, block_table)
    Eng->>Att: model(prompt tokens)
    Att->>Pool: write(slot_mapping, K, V)
    Att->>Att: SDPA causal on step K/V
    Eng->>Eng: sample first token

    Note over Eng,Pool: Decode loop
    Eng->>BM: may_append(block_table, num_tokens)
    Eng->>Eng: slots_for_range(pos, pos+1)
    Eng->>Ctx: set(is_prefill=False, seq_len)
    Eng->>Att: model(one token)
    Att->>Pool: write(slot_mapping, K, V)
    Att->>Pool: gather(block_table, seq_len)
    Pool-->>Att: K_prefix, V_prefix
    Att->>Att: SDPA non-causal Q vs prefix
    Eng->>Eng: sample next token

    Eng->>BM: free(block_table)
    Eng->>Ctx: set(None)
